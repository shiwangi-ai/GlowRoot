# PostgreSQL shared with admin and packages/db.
DATABASE_URL="postgresql://glowroot:change-me@localhost:5432/glowroot?schema=public"

# Google Maps JavaScript API key (public — restricted by HTTP referrer, not secrecy).
# Get one at console.cloud.google.com:
#   1. Create a project
#   2. Enable "Maps JavaScript API" and "Geocoding API"
#   3. Credentials -> Create API key
#   4. Restrict it: Application restrictions -> HTTP referrers -> http://localhost:3000/*
# Then copy this file to .env.local and paste your key below.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
