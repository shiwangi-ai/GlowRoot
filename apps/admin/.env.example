# Admin app configuration.
#
# Staff credentials are NOT configured here any more — accounts live in
# `admin_users` and arrive by invitation. See docs/admin-rbac.md.

# Postgres, shared with packages/db.
DATABASE_URL="postgresql://user:password@localhost:5432/glowroot?schema=public"

# Used to build invitation and password-reset links.
ADMIN_BASE_URL=http://localhost:3001
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Google Places location search on the Locations screen. Enable Maps JavaScript
# API and Places API (New), then restrict this browser key to the admin site's
# HTTP referrers (for local development: http://localhost:3001/*).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
